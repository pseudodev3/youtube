# GRIDLOOP Railway production bot
# Use a fresh 32+ character random value. Put the same value in Ghost OS Vercel as GRIDLOOP_AGENT_KEY.
GRIDLOOP_AGENT_KEY=

# Attach a Railway volume. The worker automatically uses RAILWAY_VOLUME_MOUNT_PATH.
# Optional manual override:
# GRIDLOOP_DATA_DIR=/data

# Nigeria / WAT schedule. Defaults shown.
GRIDLOOP_TZ_OFFSET_MINUTES=60
GRIDLOOP_MORNING=09:17
GRIDLOOP_EVENING=21:17

# Existing YouTube OAuth credentials. Do not commit real values.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOAD_ENABLED=true
YOUTUBE_PRIVACY_STATUS=public

# Optional but recommended: fine-grained GitHub token restricted to pseudodev3/youtube
# with Contents read/write. This only syncs career_state.json; it does not run Actions.
GRIDLOOP_GITHUB_TOKEN=
GRIDLOOP_GITHUB_REPO=pseudodev3/youtube
GRIDLOOP_GITHUB_BRANCH=main

FPS=30
DURATION=24
MAX_RENDER_ATTEMPTS=3
